[TEMPLATE]
# Copia este archivo a .env.local y rellena los valores.

# Contraseña para entrar al panel admin
ADMIN_PASSWORD=

# Secreto para firmar la sesión (genera uno con: openssl rand -base64 32)
ADMIN_SECRET=

# Carpeta de datos compartida con la web (solo modo local).
# Debe apuntar a la carpeta data de la web:
VXCORE_DATA_DIR=C:\Users\nene\Desktop\VXCore Web\data

# ------------------------------------------------------------------
# MODO REMOTO (Vercel / Turso) — OBLIGATORIO en producción
# ------------------------------------------------------------------
# En Vercel NO hay disco persistente: sin Turso el admin degrada a memoria
# (puedes navegar, pero nada se guarda y las acciones devuelven 503).
# Crea una base gratis en https://turso.tech
#   turso db create vxcore
#   turso db show vxcore --url
#   turso db tokens create vxcore
# IMPORTANTE: la web (VXCore Web) también debe apuntar a la misma base
# para que ambos compartan los datos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL de la web pública (enlace "Ver web" del admin)
NEXT_PUBLIC_APP_URL=https://vxcore-web.vercel.app
